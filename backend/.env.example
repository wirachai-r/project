APP_NAME=Laravel
AI_ENABLED=false
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=300
AI_TREND_CACHE_MINUTES=15
AI_STORE_RESPONSES=false
AI_MAX_CLARIFICATION_ATTEMPTS=3
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "s3" in production to store images in the Supabase Storage bucket.
IMAGE_FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail API mail transport (works over HTTPS on hosts that block SMTP ports)
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_FROM_ADDRESS=
GMAIL_API_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Supabase examples:
# AWS_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/uploads
# AWS_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

L5_SWAGGER_CONST_HOST=http://localhost:8000

# =========================================================================
# Google OAuth Credentials (สำหรับ Google Login)
# =========================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Firebase Cloud Messaging (server-side HTTP v1)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

# =========================================================================
# Mail Settings (การตั้งค่าส่งอีเมล Reset Password)
# =========================================================================
# สำหรับการทดสอบในเครื่อง Local แนะนำเปลี่ยน MAIL_MAILER เป็น "log" หรือใช้ "smtp"
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AI_ENABLED=true
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=900
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=300
AI_TREND_CACHE_MINUTES=15
AI_STORE_RESPONSES=true
AI_MAX_CLARIFICATION_ATTEMPTS=3
