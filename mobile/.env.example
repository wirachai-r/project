API_BASE_URL=http://10.0.2.2:8000/api
GOOGLE_SERVER_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=YOUR_IOS_OR_WEB_CLIENT_ID.apps.googleusercontent.com
# Use a production tile provider URL before release. The OpenStreetMap public
# server is best-effort and prints a flutter_map suitability warning by design.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=com.checkup.mobile
